height-default elementor-section-height-default\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-cd73a30\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-fed2bb8 elementor-position-left elementor-vertical-align-bottom elementor-widget elementor-widget-image-box\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"284\" height=\"314\" src=\"/uploads/2022/05/migration.svg\" class=\"elementor-animation-bob attachment-full size-full wp-image-1442\" alt=\"Welcome students group migation\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"elementor-image-box-content\"><h3 class=\"elementor-image-box-title\">Orientación</h3><p class=\"elementor-image-box-description\">¡Welcome te da la bienvenida en Australia! Desde la recogida en el aeropuerto hasta tour por la ciudad, te guíamos y acompañamos a dar tus primeros pasos en Australia.</p></div></div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-7a06f6c\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-62d8cab elementor-position-left elementor-vertical-align-bottom elementor-widget elementor-widget-image-box\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"128\" height=\"115\" src=\"/uploads/2022/05/asistencia.svg\" class=\"elementor-animation-bob attachment-full size-full wp-image-2176\" alt=\"Welcome students asistencia\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"elementor-image-box-content\"><h3 class=\"elementor-image-box-title\">Asistencia</h3><p class=\"elementor-image-box-description\">Welcome ofrece asistencia continua en todo el proceso para estudiar y trabajar en Australia. Desde la guía en el proceso de matricula y aplicación de visa, hasta el soporte integral en toda tu estadía en Australia.  <br><br></p></div></div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-c9673d9 elementor-hidden-desktop elementor-hidden-laptop elementor-hidden-tablet elementor-hidden-mobile elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-fb5eba9\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7f19189 elementor-position-left elementor-vertical-align-bottom elementor-widget elementor-widget-image-box\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img width=\"128\" height=\"115\" src=\"/uploads/2022/05/comunidad.svg\" class=\"attachment-full size-full wp-image-2177\" alt=\"Welcome students comunidad\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"elementor-image-box-content\"><h3 class=\"elementor-image-box-title\">Comunidad</h3><p class=\"elementor-image-box-description\">En Welcome ofrecemos a todos nuestros estudiantes una serie de actividades que realizamos durante todo el año para brindarles la mejor experiencia posible en su viaje como estudiante internacional.\n</p></div></div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-02c2370\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3a0a988 elementor-position-left elementor-vertical-align-bottom elementor-widget elementor-widget-image-box\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-image-box-wrapper\"><figure class=\"elementor-image-box-img\"><img loading=\"lazy\" width=\"112\" height=\"113\" src=\"/uploads/2022/05/dormida.svg\" class=\"elementor-animation-bob attachment-full size-full wp-image-2106\" alt=\"Welcome students alojamiento\" decoding=\"async\"></figure><div class=\"elementor-image-box-content\"><h3 class=\"elementor-image-box-title\">Alojamiento</h3><p class=\"elementor-image-box-description\">Welcome te ofrece orientación completa en la búsqueda y selección de alojamiento en Australia. Ya sea que prefieras residencias estudiantiles, apartamentos compartidos o casas de familia, te ayudamos a seleccionar la opción que mejor se adapte a tus necesidades, preferencias y  presupuesto.</p></div></div>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-0fa188c elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-59c15cc\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6815743 elementor-widget elementor-widget-spacer\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"></div>\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f10e897 elementor-widget elementor-widget-heading\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Propósito de Welcome Students Group</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b67bd0b elementor-widget elementor-widget-text-editor\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>En Welcome trabajamos día a día para mejorar la experiencia de los estudiantes internacionales, brindándoles todo lo que necesitan para vivir, estudiar y trabajar en el exterior.</p><p>Nuestro propósito es ayudar a cumplir sueños, apoyar, acompañar, asesorar, e impulsar a nuestros estudiantes a seguir adelante y alcanzar su máximo potencial a través de la educación.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a43311b elementor-widget elementor-widget-spacer\" data-element_type=\"widget\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"></div>\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-elem