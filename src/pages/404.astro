---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist. Explore our study and migration services or contact our team." noindex>
  <section class="section">
    <div class="container center">
      <span class="eyebrow">Error 404</span>
      <h1 class="h2 mt-3">We couldn't find that page</h1>
      <p class="lede mx-auto mt-3">It may have moved. Try one of these instead:</p>
      <div class="cta-row cta-row--center">
        <a href="/" class="btn btn-primary">Go to home</a>
        <a href="/services/" class="btn btn-secondary">Our services</a>
        <a href="/contact/" class="btn btn-secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
