---
/**
 * Archivos de categoría del blog, con las URLs de WordPress:
 *   /category/social/  y  /category/social/page/2/
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import WpContent from '@/components/WpContent.astro';
import { categories, postsInCategory, templates, type WpCategory } from '@/lib/wp';

export function getStaticPaths() {
  const perPage = Number(templates.archive.html.match(/<wsg-posts[^>]*per-page="(\d+)"/)?.[1] || 10);
  const out: { params: { cat: string; page: string | undefined }; props: { category: WpCategory; pageNum: number } }[] = [];
  for (const category of categories) {
    const total = Math.max(1, Math.ceil(postsInCategory(category.slug).length / perPage));
    out.push({ params: { cat: category.slug, page: undefined }, props: { category, pageNum: 1 } });
    for (let n = 2; n <= total; n++) out.push({ params: { cat: category.slug, page: `page/${n}` }, props: { category, pageNum: n } });
  }
  return out;
}

const { category, pageNum } = Astro.props;
const list = postsInCategory(category.slug);
const baseUrl = `/category/${category.slug}/`;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const title = pageNum > 1 ? `${category.name} – Página ${pageNum}` : category.name;
const description = category.description || `Artículos de la categoría ${category.name} del blog de Welcome Students Group: consejos para estudiar, vivir y trabajar en Australia.`;
---

<BaseLayout
  title={title}
  description={description}
  pageCss={[templates.archive.css]}
  bodyClass={`archive category category-${category.slug} category-${category.id} elementor-page-${templates.archive.elementorId} elementor-template-full-width`}
  breadcrumbs={[
    { name: 'Blog', href: '/blog/' },
    { name: category.name, href: baseUrl },
  ]}
  pageType="CollectionPage"
  noindex={pageNum > 1}
>
  <div class={`elementor elementor-${templates.archive.elementorId} elementor-location-archive`} data-elementor-type="archive">
    <h1 class="elementor-screen-only">{category.name}</h1>
    <WpContent
      html={templates.archive.html}
      posts={list}
      page={pageNum}
      baseUrl={baseUrl}
      replacements={{ '<wsg-post-title></wsg-post-title>': esc(category.name), __WSG_CURRENT_URL__: baseUrl }}
    />
  </div>
</BaseLayout>
