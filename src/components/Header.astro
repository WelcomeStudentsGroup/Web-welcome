---
/**
 * Header importado del WordPress (plantilla de Elementor 15): logo, menú con
 * desplegables y botón de menú móvil. El HTML viene de src/content/wp/layout.json;
 * aquí solo se marca el ítem activo y se agregan las flechas de los submenús.
 */
import { layout } from '@/lib/wp';

const current = Astro.url.pathname;
// Misma flecha que añadía Elementor (smartmenus): un caret sólido de Font Awesome.
const chevron = '<span class="sub-arrow" aria-hidden="true"><i class="fas fa-caret-down"></i></span>';

let html = layout.header;
// Ítem de menú activo (WordPress lo marcaba con current-menu-item / elementor-item-active).
html = html.replace(/<a href="([^"]+)"( aria-current="page")? class="(elementor-item|elementor-sub-item)"/g, (m, href, _cur, cls) =>
  href === current ? `<a href="${href}" aria-current="page" class="${cls} elementor-item-active"` : m,
);
// Flecha para abrir/cerrar submenús (táctil y teclado); en escritorio también abren al pasar el cursor.
html = html.replace(/(<li class="menu-item[^"]*menu-item-has-children[^"]*">\s*<a [^>]*>[^<]*)(<\/a>)/g, (_m, start, end) => `${start}${chevron}${end}`);
---

<header class="elementor elementor-15 elementor-location-header" id="siteHeader">
  <Fragment set:html={html} />
</header>
