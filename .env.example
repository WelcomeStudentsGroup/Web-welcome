# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Dominio público del sitio (canonical, sitemap, Open Graph). Sin barra final.
SITE_URL=https://welcomestudentsgroup.com.au

# Endpoint que recibe los formularios (POST JSON). Ejemplos: Formspree, Web3Forms,
# una función serverless o el CRM. Si se deja vacío, los formularios muestran
# los datos de contacto directo (WhatsApp / email) en lugar de enviar.
PUBLIC_FORM_ENDPOINT=
